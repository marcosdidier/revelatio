# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Anthropic API key — create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Azure Document Intelligence — Portal → di-revelatio-test → "Keys and Endpoint"
AZURE_DI_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_DI_KEY=...

# Google Sheet ID — from the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# See DEPLOY.md (bloco 2) for sheet setup + service-account sharing.
GOOGLE_SHEET_ID=

# Google Cloud service-account JSON, on a single line — paste the entire key file.
# See DEPLOY.md (bloco 1) for service-account creation + key download.
# On Streamlit Cloud, paste this as a triple-quoted TOML string in the secrets UI.
GOOGLE_SERVICE_ACCOUNT_JSON=
